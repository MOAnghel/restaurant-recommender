# ==============================
# Root .gitignore for Monorepo
# ==============================

# ==============================
# IDE and Editor Files
# ==============================
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
*.swp
*.swo
*~

# ==============================
# Operating System Files
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==============================
# Java/Maven/Spring Boot
# ==============================
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Spring Boot
!.mvn/wrapper/maven-wrapper.properties
spring-boot-starter-*/**

# ==============================
# Node.js/Next.js/TypeScript
# ==============================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js
.next/
out/

# Production
build/
dist/

# Misc
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ==============================
# Database Files
# ==============================
*.db
*.ldb
*.sqlite
*.sqlite3
*.h2.db
*.trace.db

# ==============================
# Environment Variables
# ==============================
.env
.env.local
.env.*.local
*.env

# API Keys (be explicit about what to ignore)
# Add specific files that might contain secrets
secrets/
keys/

# ==============================
# Logs and Reports
# ==============================
logs/
*.log
coverage/
.nyc_output/

# ==============================
# Temporary Files
# ==============================
tmp/
temp/
.cache/

# ==============================
# Docker
# ==============================
docker-compose.override.yml
.env.docker

# ==============================
# Documentation Build Output
# ==============================
docs/_build/
site/

# ==============================
# Misc
# ==============================
# Keep config files but ignore secrets
!*.example
!*.template
!*.sample

# Test files (optional - uncomment if you want to ignore test data)
# test-data/
# mock-data/